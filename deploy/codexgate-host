#!/usr/bin/env bash
# codexgate-host: the only part of CodexGate that runs as root (CodexGate calls it through sudo).
#
# It gives every CodexGate user who runs server sessions a system account of their own (cg-<id>)
# and runs tmux as that account, so one teammate's Codex can read neither another teammate's files
# nor the gateway's database, cookie keys or environment. Every argument is matched against a
# strict pattern and nothing user-supplied ever reaches a shell.
#
#   provision <id> <gateway-url> <model>          (key, optional, on stdin)
#   new       <id> <session> <cols> <rows> <dir> <program: codex|shell> <memory-mb>
#   attach    <id> <session>                      (tmux control mode on stdin/stdout)
#   list      <id>
#   kill      <id> <session>
#   version
set -euo pipefail
umask 077
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

readonly HOME_ROOT=/home
readonly SOCKET=codexgate
readonly VERSION=1

die() { echo "codexgate-host: $*" >&2; exit 2; }
check() { [[ "$2" =~ $3 ]] || die "invalid $1"; }

user_env() {  # a clean environment: nothing of the gateway's (upstream keys live there) reaches a session
  local acct=$1
  ENVV=(env -i "HOME=$HOME_ROOT/$acct" "USER=$acct" "LOGNAME=$acct" SHELL=/bin/bash
        PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 TERM=xterm-256color)
}

as_user() {
  local acct=$1; shift
  user_env "$acct"
  runuser -u "$acct" -- "${ENVV[@]}" "$@"
}

need_account() {
  id -u "$1" >/dev/null 2>&1 || die "no account $1"
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift

case "$cmd" in
  version)
    echo "$VERSION"
    ;;

  provision)
    [[ $# -eq 3 ]] || die "usage: provision <id> <gateway-url> <model>"
    check id "$1" '^[0-9]{1,9}$'
    check url "$2" '^https?://[A-Za-z0-9.:/_-]{1,200}$'
    check model "$3" '^[A-Za-z0-9._:/@-]{1,128}$'
    acct="cg-$1"
    if ! id -u "$acct" >/dev/null 2>&1; then
      useradd --create-home --home-dir "$HOME_ROOT/$acct" --shell /bin/bash --user-group \
        --comment "CodexGate user $1" "$acct"
    fi
    chmod 700 "$HOME_ROOT/$acct"
    key=""
    IFS= read -r key || true
    [[ -z "$key" ]] || check key "$key" '^cgk_[A-Za-z0-9_-]{20,100}$'
    # Files are written by the account itself, never by root into a directory the account controls.
    as_user "$acct" mkdir -p "$HOME_ROOT/$acct/.codex" "$HOME_ROOT/$acct/work"
    printf 'model = "%s"\nmodel_provider = "codexgate"\n\n[model_providers.codexgate]\nname = "CodexGate"\nbase_url = "%s"\nenv_key = "CODEXGATE_API_KEY"\nwire_api = "responses"\nsupports_websockets = false\nstream_idle_timeout_ms = 600000\n' \
      "$3" "$2" | as_user "$acct" sh -c 'umask 077; cat > "$HOME/.codex/config.toml"'
    if [[ -n "$key" ]]; then
      printf 'CODEXGATE_API_KEY=%s\n' "$key" | as_user "$acct" sh -c 'umask 077; cat > "$HOME/.codex/.env"'
    fi
    ;;

  new)
    [[ $# -eq 7 ]] || die "usage: new <id> <session> <cols> <rows> <dir> <program> <memory-mb>"
    check id "$1" '^[0-9]{1,9}$'
    check session "$2" '^s[0-9]{1,12}$'
    check cols "$3" '^[0-9]{2,3}$'
    check rows "$4" '^[0-9]{1,3}$'
    check dir "$5" '^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
    check program "$6" '^(codex|shell)$'
    check memory "$7" '^[0-9]{1,7}$'
    acct="cg-$1"
    need_account "$acct"
    workdir="$HOME_ROOT/$acct/work/$5"
    as_user "$acct" mkdir -p "$workdir"
    if [[ "$6" == codex ]]; then prog=(codex); else prog=(bash -l); fi
    user_env "$acct"
    tmux_new=(tmux -L "$SOCKET" new-session -d -s "$2" -x "$3" -y "$4" -c "$workdir" "${prog[@]}")
    if [[ "$7" != 0 ]] && command -v systemd-run >/dev/null 2>&1 && [[ -d /run/systemd/system ]]; then
      # The whole tmux server of this account lives in a scope with a memory cap.
      systemd-run --quiet --collect --scope --uid="$acct" --gid="$acct" --slice=codexgate.slice \
        -p MemoryMax="$7M" -p TasksMax=1024 -- "${ENVV[@]}" "${tmux_new[@]}"
    else
      runuser -u "$acct" -- "${ENVV[@]}" "${tmux_new[@]}"
    fi
    as_user "$acct" tmux -L "$SOCKET" set-option -g status off ';' set-option -g history-limit 20000 ';' \
      set-option -g window-size latest ';' set-option -sg escape-time 10 >/dev/null
    ;;

  attach)
    [[ $# -eq 2 ]] || die "usage: attach <id> <session>"
    check id "$1" '^[0-9]{1,9}$'
    check session "$2" '^s[0-9]{1,12}$'
    acct="cg-$1"
    need_account "$acct"
    user_env "$acct"
    exec runuser -u "$acct" -- "${ENVV[@]}" tmux -L "$SOCKET" -C attach-session -t "$2"
    ;;

  list)
    [[ $# -eq 1 ]] || die "usage: list <id>"
    check id "$1" '^[0-9]{1,9}$'
    acct="cg-$1"
    id -u "$acct" >/dev/null 2>&1 || exit 0
    as_user "$acct" tmux -L "$SOCKET" list-sessions -F '#{session_name} #{session_created} #{session_attached}' 2>/dev/null || true
    ;;

  kill)
    [[ $# -eq 2 ]] || die "usage: kill <id> <session>"
    check id "$1" '^[0-9]{1,9}$'
    check session "$2" '^s[0-9]{1,12}$'
    acct="cg-$1"
    id -u "$acct" >/dev/null 2>&1 || exit 0
    as_user "$acct" tmux -L "$SOCKET" kill-session -t "$2" 2>/dev/null || true
    ;;

  *)
    die "unknown command"
    ;;
esac
